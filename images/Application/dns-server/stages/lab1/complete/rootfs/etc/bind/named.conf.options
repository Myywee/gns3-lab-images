acl lab_networks {
    127.0.0.1;
    10.10.0.0/16;
};

options {
    directory "/var/cache/bind";

    listen-on {
        127.0.0.1;
        10.10.20.10;
    };

    listen-on-v6 { none; };

    allow-query { lab_networks; };
    allow-recursion { lab_networks; };
    allow-query-cache { lab_networks; };
    recursion yes;

    minimal-responses yes;
    dnssec-validation auto;

    // Intentionally no forwarders: BIND must query root, TLD, and
    // authoritative servers itself so the iterative path is observable.
};
